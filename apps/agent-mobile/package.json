{
  "name": "@zero/agent-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@clerk/expo": "^4.8.1",
    "@expo/material-symbols": "^0.1.1",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ui": "~57.0.22",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/db": "0.12.1",
    "@tanstack/query-db-collection": "1.4.0",
    "@tanstack/react-db": "0.5.5",
    "@tanstack/react-query": "5.104.1",
    "@zero/agent-core": "workspace:*",
    "@zeroapps/recurrence": "workspace:*",
    "clsx": "^2.1.1",
    "expo": "~57.0.27",
    "expo-auth-session": "~57.0.14",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.22.6",
    "react-native-reanimated": "4.5.5",
    "react-native-reorderable-list": "^0.18.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "0.10.1",
    "rn-emoji-keyboard": "^1.7.0",
    "tailwind-merge": "^3.7.0",
    "tinybase": "10.0.1",
    "uniwind": "^1.12.2"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@expo/config-plugins": "57.0.10",
    "@jest/globals": "^29.7.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "tailwindcss": "^4.1.16",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "e2e:pixel": "bash .maestro/run-metro-e2e.sh",
    "e2e:medicine-native": "bash .maestro/medicine-native-proof.sh",
    "lint": "eslint .",
    "uniwind:types": "uniwind generate-artifacts --css ./global.css --dts ./src/uniwind-types.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests --forceExit --runInBand"
  },
  "jest": {
    "preset": "jest-expo",
    "silent": true,
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^react$": "<rootDir>/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1",
      "^chrono-node/en$": "<rootDir>/../../packages/recurrence/node_modules/chrono-node/dist/cjs/locales/en/index.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|fractional-indexing|chrono-node|rrule-temporal|temporal-polyfill|temporal-spec|temporal-utils|tinybase))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "testTimeout": 60000
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-keyboard-controller",
        "react-native-reanimated"
      ]
    }
  }
}
