{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zero-api-test",
  "main": "./src/index.ts",
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "dev": {
    "port": 8791
  },
  "vars": {
    "TELEGRAM_API_ROOT": "http://localhost:3501",
    "LLM_BASE_URL_OVERRIDE": "http://localhost:3502",
    "ENVIRONMENT": "test",
    "MODEL_ID": "claude-sonnet-4-6",
    "CLOUDFLARE_ACCOUNT_ID": "test-account",
    "CLOUDFLARE_GATEWAY_ID": "test-gateway"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "c585ffa89cbb45448d2480491434b2ee",
      "preview_id": "c585ffa89cbb45448d2480491434b2ee"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "zero-attachments"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "zero-events" },
    { "binding": "AI_USAGE", "dataset": "zero-ai-usage" }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_DO",
        "class_name": "UserDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserDO", "ProjectDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SessionDO", "AgentContainer"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["ProjectDO"]
    },
    {
      "tag": "v4",
      "deleted_classes": ["UserDO", "SessionDO"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["UserDO"]
    },
    {
      "tag": "v6",
      "deleted_classes": ["AgentContainer"]
    }
  ]
}
