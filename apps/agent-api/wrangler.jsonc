{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zero-api",
  "main": "./src/index.ts",
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": {
    "required": [
      "ADMIN_USER_ID",
      "BRAVE_API_KEY",
      "CLERK_PUBLISHABLE_KEY",
      "CLERK_SECRET_KEY",
      "CLERK_WEBHOOK_SIGNING_SECRET",
      "CLOUDFLARE_API_KEY",
      "CLOUDFLARE_ANALYTICS_TOKEN",
      "DISCORD_SIGNUP_WEBHOOK_URL",
      "ENVIRONMENT",
      "GITHUB_APP_ID",
      "GITHUB_APP_PRIVATE_KEY",
      "TAVILY_API_KEY",
      "TELEGRAM_BOT_INFO",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET",
      "ZEROVAULT_API_KEY"
    ]
  },
  "assets": {
    "directory": "../agent-web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "dev": {
    "port": 8790
  },
  "vars": {
    "TELEGRAM_API_ROOT": "https://api.telegram.org",
    "CLOUDFLARE_ACCOUNT_ID": "4e04b64af4013414441c59014392bea0",
    "CLOUDFLARE_GATEWAY_ID": "zero",
    "MODEL_ID": "gpt-5.6-luna",
    "LLM_BASE_URL_OVERRIDE": ""
  },
  "routes": [
    { "pattern": "zero.juanibiapina.dev/*", "zone_name": "juanibiapina.dev" }
  ],
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 300000
  },
  "ai": {
    "binding": "AI"
  },
  "upload_source_maps": true,
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "c585ffa89cbb45448d2480491434b2ee",
      "preview_id": "c585ffa89cbb45448d2480491434b2ee"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "zero-attachments"
    }
  ],
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "zero-events" },
    { "binding": "AI_USAGE", "dataset": "zero-ai-usage" }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_DO",
        "class_name": "UserDO"
      },
      {
        "name": "SCHEDULE_DO",
        "class_name": "ScheduleDO"
      },
      {
        "name": "LEARNING_DO",
        "class_name": "LearningDO"
      },
      {
        "name": "TELEGRAM_ACCOUNT_DO",
        "class_name": "TelegramAccountDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserDO", "ProjectDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SessionDO", "AgentContainer"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["ProjectDO"]
    },
    {
      "tag": "v4",
      "deleted_classes": ["UserDO", "SessionDO"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["UserDO"]
    },
    {
      "tag": "v6",
      "deleted_classes": ["AgentContainer"]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["ScheduleDO", "LearningDO"]
    },
    {
      "tag": "v8",
      "new_sqlite_classes": ["TelegramAccountDO"]
    }
  ]
}
