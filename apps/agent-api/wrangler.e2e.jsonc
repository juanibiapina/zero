{
  // Release E2E worker config. Mirrors wrangler.test.jsonc (ENVIRONMENT=test, so
  // the /api/* auth bypass trusts the fake bearer) but drops the `ai` binding.
  // The `ai` binding runs in remote mode and forces wrangler to open a remote
  // proxy session that needs CLOUDFLARE_API_TOKEN; the release flows only touch
  // tasks/captures (no LLM), and no code reads env.AI, so removing it keeps the
  // stack fully local and credential-free.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zero-api-e2e",
  "main": "./src/index.ts",
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "dev": {
    "port": 8787
  },
  "vars": {
    "TELEGRAM_API_ROOT": "http://localhost:3501",
    "LLM_BASE_URL_OVERRIDE": "http://localhost:3502",
    "ENVIRONMENT": "test",
    "MODEL_ID": "gpt-6-luna",
    "CLOUDFLARE_ACCOUNT_ID": "test-account",
    "CLOUDFLARE_GATEWAY_ID": "test-gateway"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "c585ffa89cbb45448d2480491434b2ee",
      "preview_id": "c585ffa89cbb45448d2480491434b2ee"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "zero-attachments"
    }
  ],
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "zero-events" },
    { "binding": "AI_USAGE", "dataset": "zero-ai-usage" }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_DO",
        "class_name": "UserDO"
      },
      {
        "name": "TELEGRAM_ACCOUNT_DO",
        "class_name": "TelegramAccountDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserDO", "ProjectDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SessionDO", "AgentContainer"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["ProjectDO"]
    },
    {
      "tag": "v4",
      "deleted_classes": ["UserDO", "SessionDO"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["UserDO"]
    },
    {
      "tag": "v6",
      "deleted_classes": ["AgentContainer"]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["TelegramAccountDO"]
    }
  ]
}
