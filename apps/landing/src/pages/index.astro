---
import "../styles/global.css";

const vaultUrl = "https://dash.zeroapps.dev/vault/projects";
const errorsUrl = "https://dash.zeroapps.dev/errors/issues";
const dashUrl = "https://dash.zeroapps.dev/";
const docsUrl = "https://docs.zeroapps.dev/";
const vaultDocsUrl = "https://docs.zeroapps.dev/vault/getting-started/";
const errorsDocsUrl = "https://docs.zeroapps.dev/errors/getting-started/";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "Zero",
      url: "https://zeroapps.dev/",
      logo: "https://zeroapps.dev/og-image.png",
    },
    { "@type": "WebSite", name: "Zero", url: "https://zeroapps.dev/" },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="One credential for every Zero product, built for indie developers and small teams." />
    <link rel="canonical" href="https://zeroapps.dev/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-latin.woff2" crossorigin />
    <meta property="og:title" content="Zero | One credential for every product" />
    <meta property="og:description" content="One credential for every Zero product, built for indie developers and small teams." />
    <meta property="og:url" content="https://zeroapps.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Zero" />
    <meta property="og:image" content="https://zeroapps.dev/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Zero | One credential for every product" />
    <meta name="twitter:description" content="One credential for every Zero product, built for indie developers and small teams." />
    <meta name="twitter:image" content="https://zeroapps.dev/og-image.png" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <title>Zero | One credential for every product</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Zero home">Zero.</a>
      <nav aria-label="Primary navigation">
        <a href={docsUrl}>Docs</a>
        <a href={vaultUrl}>Dashboard</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="page-title">
        <h1 id="page-title">One credential.<br />Every Zero product.</h1>
        <p class="lede">Sign in from your terminal. Let CI prove itself. For indie developers and small teams.</p>
        <div class="hero-actions">
          <a class="button" href={dashUrl}>Open the dashboard</a>
        </div>
      </section>

      <section class="products" aria-label="Products">
        <article class="product">
          <h2>Vault</h2>
          <div class="product-copy">
            <p class="product-statement">Secrets by product and environment.</p>
            <p class="product-description">Store and update values from the dashboard or CLI. GitHub Actions reads them with no API key stored in your repository.</p>
            <div class="product-links">
              <a href={vaultUrl}>Open Vault</a>
              <a class="product-doc" href={vaultDocsUrl}>Setup guide</a>
            </div>
          </div>
        </article>

        <article class="product">
          <h2>Errors</h2>
          <div class="product-copy">
            <p class="product-statement">See which failures keep happening.</p>
            <p class="product-description">Send an HTTP report with a project name and message. Include a stack trace or context when available. Zero groups repeated failures into issues and creates the project view from the reports you send.</p>
            <div class="product-links">
              <a href={errorsUrl}>Open Errors</a>
              <a class="product-doc" href={errorsDocsUrl}>Setup guide</a>
            </div>
          </div>
        </article>
      </section>
    </main>

    <footer class="site-footer">
      <a class="wordmark" href="/" aria-label="Zero home">Zero.</a>
      <nav class="footer-nav" aria-label="Footer">
        <a href={docsUrl}>Docs</a>
        <a href={vaultUrl}>Dashboard</a>
      </nav>
    </footer>
  </body>
</html>
