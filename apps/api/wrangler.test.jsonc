{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zero-api-test",
  "main": "./src/index.ts",
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }
  ],
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "dev": {
    "port": 8791
  },
  "vars": {
    "TELEGRAM_API_ROOT": "http://localhost:3501",
    "LLM_BASE_URL_OVERRIDE": "http://localhost:3502",
    "ENVIRONMENT": "test",
    "MODEL_ID": "claude-sonnet-4-5",
    "CLOUDFLARE_ACCOUNT_ID": "test-account",
    "CLOUDFLARE_GATEWAY_ID": "test-gateway"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "c585ffa89cbb45448d2480491434b2ee",
      "preview_id": "c585ffa89cbb45448d2480491434b2ee"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AGENT_STATE_BUCKET",
      "bucket_name": "zero-agent-state"
    }
  ],
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "zero-events" }
  ],
  "d1_databases": [
    {
      "binding": "SESSIONS_DB",
      "database_name": "zero-sessions",
      "database_id": "32f3e4b4-004a-4c51-a3e0-cb67fd7e3bf8"
    }
  ],
  "containers": [
    {
      "class_name": "AgentContainer",
      "image": "../../packages/agent-server/Dockerfile",
      "max_instances": 10,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_CONTAINER",
        "class_name": "AgentContainer"
      },
      {
        "name": "USER_DO",
        "class_name": "UserDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserDO", "ProjectDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SessionDO", "AgentContainer"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["ProjectDO"]
    },
    {
      "tag": "v4",
      "deleted_classes": ["UserDO", "SessionDO"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["UserDO"]
    }
  ]
}
