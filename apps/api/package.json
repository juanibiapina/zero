{
  "name": "@zero/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790 --inspector-port 9232",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate --config src/UserDO/db/drizzle.config.ts && drizzle-kit generate --config src/ProjectDO/db/drizzle.config.ts && drizzle-kit generate --config src/SessionDO/db/drizzle.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.1.0",
    "@hono/clerk-auth": "^2.0.0",
    "@hono/zod-openapi": "^1.2.2",
    "@zero/drizzle-migrator": "workspace:*",
    "@zero/core": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260218.0",
    "@zero/eslint-config": "workspace:*",
    "@zero/typescript-config": "workspace:*",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.3",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "wrangler": "^4.67.0"
  }
}
