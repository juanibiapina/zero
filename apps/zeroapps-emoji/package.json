{
  "name": "@zeroapps/emoji",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "zero vault run -p zeroapps-emoji -e development --mount .dev.vars -- vite dev",
    "build": "vite build",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --config wrangler.jsonc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.8",
    "@zeroapps/emoji-suggest": "workspace:*",
    "@zeroapps/typesafe": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/node": "^26.6.6",
    "@zero/eslint-config": "workspace:*",
    "@zero/typescript-config": "workspace:*",
    "eslint": "10.8.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.147.0"
  }
}
