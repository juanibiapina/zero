{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zero-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": {
    "required": [
      "CLERK_PUBLISHABLE_KEY",
      "CLERK_SECRET_KEY",
      "CLERK_WEBHOOK_SIGNING_SECRET",
      "DISCORD_SIGNUP_WEBHOOK_URL",
      "ENVIRONMENT",
      "OPENAI_API_KEY",
      "TYPESAFE_API_KEY",
      "ZERO_API_KEY"
    ]
  },
  "routes": [
    { "pattern": "zero.juanibiapina.dev/api/*", "zone_name": "juanibiapina.dev" },
    { "pattern": "zero.juanibiapina.dev/mcp*", "zone_name": "juanibiapina.dev" },
    { "pattern": "zero.juanibiapina.dev/.well-known/*", "zone_name": "juanibiapina.dev" }
  ],
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 300000
  },
  "upload_source_maps": true,
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "zero-events" }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_DO",
        "class_name": "UserDO"
      },
      {
        "name": "TASK_DO",
        "class_name": "TaskDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserDO", "ProjectDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SessionDO", "AgentContainer"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["ProjectDO"]
    },
    {
      "tag": "v4",
      "deleted_classes": ["UserDO", "SessionDO"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["UserDO"]
    },
    {
      "tag": "v6",
      "deleted_classes": ["AgentContainer"]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["ScheduleDO", "LearningDO"]
    },
    {
      "tag": "v8",
      "new_sqlite_classes": ["TelegramAccountDO"]
    },
    {
      "tag": "v9",
      "new_sqlite_classes": ["TaskDO"]
    },
    {
      "tag": "v10",
      "new_sqlite_classes": ["AssistantDO"]
    },
    {
      "tag": "v11",
      "deleted_classes": ["LearningDO"]
    },
    {
      "tag": "v12",
      "deleted_classes": ["AssistantDO", "ScheduleDO", "TelegramAccountDO"]
    }
  ]
}
