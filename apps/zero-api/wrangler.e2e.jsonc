{
  // Release E2E worker config. Mirrors wrangler.test.jsonc (ENVIRONMENT=test, so
  // the /api/* auth bypass trusts the fake bearer). It binds nothing remote, so
  // the stack stays fully local and credential-free.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zero-api-e2e",
  "main": "./src/index.ts",
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }
  ],
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "dev": {
    "port": 8787
  },
  "vars": {
    "ENVIRONMENT": "test"
  },
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "zero-events" }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_DO",
        "class_name": "UserDO"
      },
      {
        "name": "TASK_DO",
        "class_name": "TaskDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserDO", "ProjectDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SessionDO", "AgentContainer"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["ProjectDO"]
    },
    {
      "tag": "v4",
      "deleted_classes": ["UserDO", "SessionDO"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["UserDO"]
    },
    {
      "tag": "v6",
      "deleted_classes": ["AgentContainer"]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["TelegramAccountDO"]
    },
    {
      "tag": "v8",
      "new_sqlite_classes": ["TaskDO"]
    },
    {
      "tag": "v9",
      "new_sqlite_classes": ["ScheduleDO", "LearningDO"]
    },
    {
      "tag": "v10",
      "new_sqlite_classes": ["AssistantDO"]
    },
    {
      "tag": "v11",
      "deleted_classes": ["LearningDO"]
    },
    {
      "tag": "v12",
      "deleted_classes": ["AssistantDO", "ScheduleDO", "TelegramAccountDO"]
    }
  ]
}
