{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zero-api-test",
  "main": "./src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "TELEGRAM_API_ROOT": "http://localhost:3501",
    "LLM_BASE_URL_OVERRIDE": "http://localhost:3502",
    "ENVIRONMENT": "test",
    "MODEL_ID": "gpt-6-luna",
    "CLOUDFLARE_ACCOUNT_ID": "test-account",
    "CLOUDFLARE_GATEWAY_ID": "test-gateway"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "c585ffa89cbb45448d2480491434b2ee",
      "preview_id": "c585ffa89cbb45448d2480491434b2ee"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "zero-attachments"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "zero-events" },
    { "binding": "AI_USAGE", "dataset": "zero-ai-usage" }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_DO",
        "class_name": "UserDO"
      },
      {
        "name": "TELEGRAM_ACCOUNT_DO",
        "class_name": "TelegramAccountDO"
      },
      {
        "name": "TASK_DO",
        "class_name": "TaskDO"
      },
      {
        "name": "SCHEDULE_DO",
        "class_name": "ScheduleDO"
      },
      {
        "name": "ASSISTANT_DO",
        "class_name": "AssistantDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserDO", "ProjectDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SessionDO", "AgentContainer"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["ProjectDO"]
    },
    {
      "tag": "v4",
      "deleted_classes": ["UserDO", "SessionDO"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["UserDO"]
    },
    {
      "tag": "v6",
      "deleted_classes": ["AgentContainer"]
    },
    // This file's migration history is its own: it stops at v6 because it never
    // got the v7 that added ScheduleDO/LearningDO in wrangler.jsonc.
    {
      "tag": "v7",
      "new_sqlite_classes": ["TelegramAccountDO"]
    },
    {
      "tag": "v8",
      "new_sqlite_classes": ["TaskDO"]
    },
    {
      "tag": "v9",
      "new_sqlite_classes": ["ScheduleDO", "LearningDO"]
    },
    {
      "tag": "v10",
      "new_sqlite_classes": ["AssistantDO"]
    },
    {
      "tag": "v11",
      "deleted_classes": ["LearningDO"]
    }
  ]
}
