/**
 * Test-specific Wrangler config.
 *
 * Mirrors wrangler.jsonc but omits bindings/settings that are incompatible
 * with local-only test execution (assets directory may not exist,
 * routes/upload_source_maps are deploy-only).
 */

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zerovault-api",
  "main": "./src/index.ts",
  "compatibility_date": "2025-07-09",
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }
  ],
  "compatibility_flags": [
    "nodejs_als",
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  // Deterministic test-only master key (base64 of 32 bytes). Keeps the DO
  // crypto self-contained so the suite never depends on fetching the real
  // MASTER_KEY secret into `.dev.vars`.
  "vars": {
    "MASTER_KEY": "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
  },
  "kv_namespaces": [
    {
      "binding": "APIKEYS",
      "id": "test-apikeys"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ORGDO",
        "class_name": "OrgDO"
      },
      {
        "name": "PROJECTVAULTDO",
        "class_name": "ProjectVaultDO"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "VAULT_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VaultDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["OrgDO", "ProjectVaultDO"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["VaultDO"]
    }
  ]
}
