{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zerovault-api",
  "main": "./src/index.ts",
  "compatibility_date": "2025-07-09",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "compatibility_flags": ["nodejs_als", "nodejs_compat"],
  "secrets": {
    "required": [
      "CLERK_PUBLISHABLE_KEY",
      "CLERK_SECRET_KEY",
      "CLERK_WEBHOOK_SIGNING_SECRET",
      "DISCORD_SIGNUP_WEBHOOK_URL",
      "ENVIRONMENT",
      "MASTER_KEY",
      "ZERO_API_KEY"
    ]
  },
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "directory": "../dashboard-web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [{ "binding": "APIKEYS", "id": "7c218b0980404d559204b24f9e0f1a47" }],
  "durable_objects": {
    "bindings": [
      { "name": "ORGDO", "class_name": "OrgDO" },
      { "name": "PROJECTVAULTDO", "class_name": "ProjectVaultDO" },
      { "name": "ERRORSDO", "class_name": "ErrorsDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VaultDO"] },
    { "tag": "v2", "new_sqlite_classes": ["OrgDO", "ProjectVaultDO"] },
    { "tag": "v3", "deleted_classes": ["VaultDO"] },
    { "tag": "v4", "new_sqlite_classes": ["ErrorsDO"] }
  ],
  "ratelimits": [
    { "name": "VAULT_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 100, "period": 60 } },
    { "name": "ERRORS_RATE_LIMITER", "namespace_id": "3001", "simple": { "limit": 100, "period": 60 } },
    { "name": "CI_TOKEN_RATE_LIMITER", "namespace_id": "4001", "simple": { "limit": 20, "period": 60 } }
  ],
  "routes": [
    { "pattern": "dash.zeroapps.dev", "custom_domain": true },
    { "pattern": "api.zeroapps.dev", "custom_domain": true }
  ]
}
