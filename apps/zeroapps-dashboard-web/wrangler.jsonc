{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeroapps-dashboard-web",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "dash.zeroapps.dev", "custom_domain": true }]
}
