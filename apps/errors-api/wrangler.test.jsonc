/**
 * Test-specific Wrangler config.
 *
 * Mirrors wrangler.jsonc but omits bindings/settings incompatible with
 * local-only test execution (assets directory, custom-domain routes).
 */

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeroerrors-api",
  "main": "./src/index.ts",
  "compatibility_date": "2025-07-09",
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }
  ],
  "compatibility_flags": [
    "nodejs_als",
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "APIKEYS",
      "id": "test-apikeys"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ERRORSDO",
        "class_name": "ErrorsDO"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "ERRORS_RATE_LIMITER",
      "namespace_id": "3001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ErrorsDO"]
    }
  ]
}
