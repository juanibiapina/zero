{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeroerrors-api",
  "main": "./src/index.ts",
  "compatibility_date": "2025-07-09",
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }
  ],
  "compatibility_flags": [
    "nodejs_als",
    "nodejs_compat"
  ],
  "secrets": {
    "required": [
      "CLERK_PUBLISHABLE_KEY",
      "CLERK_SECRET_KEY",
      "ENVIRONMENT"
    ]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../errors-web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ping", "/v1/*", "/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "APIKEYS",
      "id": "7c218b0980404d559204b24f9e0f1a47"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ERRORSDO",
        "class_name": "ErrorsDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ErrorsDO"]
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "3001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "routes": [
    {
      "pattern": "zeroerrors.juanibiapina.dev",
      "custom_domain": true
    },
    {
      "pattern": "errors.apps.juanibiapina.dev",
      "custom_domain": true
    }
  ],
}
