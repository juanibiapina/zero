#!/usr/bin/env python3
"""Generate and validate Zero's static and task-count icon assets."""
import copy
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile
import xml.etree.ElementTree as ET

ROOT = Path(__file__).resolve().parent.parent
STATIC_SOURCE = ROOT / 'apps/agent-mobile/assets/brand/todo-icon.svg'
TASK_COUNT = ROOT / 'apps/agent-mobile/assets/brand/task-count'
TASK_COUNT_TEMPLATE = TASK_COUNT / 'template.svg'
MOBILE = ROOT / 'apps/agent-mobile/assets/images'
TASK_COUNT_IMAGES = MOBILE / 'task-count'
WEB = ROOT / 'apps/agent-web/public'
WEB_SVG = WEB / 'favicon-mark.svg'
WEB_PNG = WEB / 'favicon-mark.png'
RETIRED_WEB_ICONS = [
    WEB / 'todo-icon.svg',
    WEB / 'favicon.svg',
    WEB / 'favicon.png',
]
WEB_ARTWORK_SCALE = 1.435514
WEB_COVERAGE_RANGE = (0.88, 0.92)
PROTOTYPE = ROOT / 'docs/prototypes/todo-icon'
NS = 'http://www.w3.org/2000/svg'
XLINK = 'http://www.w3.org/1999/xlink'
ET.register_namespace('', NS)
ET.register_namespace('xlink', XLINK)
ENV = {**os.environ, 'MAGICK_THREAD_LIMIT': '1'}

STATES = [
    ('0-empty', 0, 1.0, []),
    ('1-task', 1, 1.35, [500]),
    ('2-tasks', 2, 1.30, [415, 585]),
    ('3-tasks', 3, 1.25, [330, 500, 670]),
    ('4-plus-tasks', 4, 1.08, [296, 432, 568, 704]),
]
LABELS = [
    '0  Clear / checkmark',
    '1  One task',
    '2  Two tasks',
    '3  Three tasks',
    '4  Four or more',
]
EMPTY_CHECK_CENTER = (512, 500)
EMPTY_CHECK_POINTS = [(318, 500), (451, 633), (718, 365)]
EMPTY_CHECK_PATH_SCALE = 1.45
EMPTY_CHECK_STROKE_SCALE = 1.28
EMPTY_FOREGROUND_BOUNDS = (520, 377, 259, 328)
EMPTY_FOREGROUND_BOUNDS_TOLERANCE = 2


def q(name):
    return f'{{{NS}}}{name}'


def icon_layers(tree, source):
    root = tree.getroot()
    if root.get('viewBox') != '0 0 1024 1024':
        raise RuntimeError(f'{source}: expected a 0 0 1024 1024 viewBox')

    groups = root.findall(q('g'))
    by_id = {group.get('id'): group for group in groups}
    if len(groups) != 2 or set(by_id) != {'background', 'artwork'}:
        raise RuntimeError(
            f'{source}: expected top-level background and artwork groups'
        )

    background = by_id['background']
    children = list(background)
    expected = {
        'x': '0',
        'y': '0',
        'width': '1024',
        'height': '1024',
        'fill': '#ffffff',
    }
    if len(children) != 1 or children[0].tag != q('rect'):
        raise RuntimeError(f'{source}: background must contain one rectangle')
    if children[0].attrib != expected:
        raise RuntimeError(
            f'{source}: background must be a full-bleed white square'
        )

    return background, by_id['artwork']


def magick(*args):
    return subprocess.check_output(
        ['magick', *map(str, args)], env=ENV, text=True
    ).strip()


def validate_corners(path, expected):
    dimensions = magick('identify', '-format', '%w %h', path)
    width, height = map(int, dimensions.split())
    corners = [
        (0, 0),
        (width - 1, 0),
        (0, height - 1),
        (width - 1, height - 1),
    ]
    for x, y in corners:
        pixel = tuple(
            map(
                float,
                magick(
                    path,
                    '-format',
                    f'%[fx:p{{{x},{y}}}.r] %[fx:p{{{x},{y}}}.g] '
                    f'%[fx:p{{{x},{y}}}.b] %[fx:p{{{x},{y}}}.a]',
                    'info:',
                ).split(),
            )
        )
        not_white = any(abs(channel - 1) > 1 / 255 for channel in pixel)
        if expected == 'white' and not_white:
            raise RuntimeError(f'{path}: corner {x},{y} is not opaque white')
        if expected == 'transparent' and pixel[3] > 1 / 255:
            raise RuntimeError(f'{path}: corner {x},{y} is not transparent')


def artwork_bounds(path):
    width, height = map(
        int, magick('identify', '-format', '%w %h', path).split()
    )
    geometry = magick(
        path,
        '-alpha',
        'extract',
        '-threshold',
        '1',
        '-format',
        '%@',
        'info:',
    )
    match = re.fullmatch(r'(\d+)x(\d+)\+(\d+)\+(\d+)', geometry)
    if match is None:
        raise RuntimeError(f'{path}: could not measure artwork bounds {geometry!r}')
    return width, height, tuple(map(int, match.groups()))


def validate_artwork_coverage(path):
    width, height, bounds = artwork_bounds(path)
    content_width, content_height, x, y = bounds
    coverage = max(content_width / width, content_height / height)
    minimum, maximum = WEB_COVERAGE_RANGE
    if not minimum <= coverage <= maximum:
        raise RuntimeError(
            f'{path}: artwork coverage {coverage:.3f} is outside '
            f'{minimum:.2f}–{maximum:.2f}'
        )

    right = width - x - content_width
    bottom = height - y - content_height
    horizontal_tolerance = max(1, round(width * 0.01))
    vertical_tolerance = max(1, round(height * 0.01))
    if (
        abs(x - right) > horizontal_tolerance
        or abs(y - bottom) > vertical_tolerance
    ):
        raise RuntimeError(
            f'{path}: artwork is not centered '
            f'(left={x}, right={right}, top={y}, bottom={bottom})'
        )


def validate_artwork_bounds(path, expected, tolerance):
    _, _, actual = artwork_bounds(path)
    if any(
        abs(actual_value - expected_value) > tolerance
        for actual_value, expected_value in zip(actual, expected)
    ):
        raise RuntimeError(
            f'{path}: artwork bounds {actual} differ from approved bounds '
            f'{expected} by more than {tolerance}px'
        )


def render(source, output, size, opaque=False):
    args = ['-background', 'none', source, '-resize', f'{size}x{size}']
    if opaque:
        args += ['-background', 'white', '-alpha', 'remove', '-alpha', 'off']
    args += [
        '-strip',
        '-define',
        'png:exclude-chunk=date,time',
        ('PNG24:' if opaque else 'PNG32:') + str(output),
    ]
    magick(*args)
    dimensions = magick('identify', '-format', '%wx%h', output)
    if dimensions != f'{size}x{size}':
        raise RuntimeError(f'{output}: unexpected dimensions {dimensions}')
    is_opaque = magick('identify', '-format', '%[opaque]', output).lower() == 'true'
    if is_opaque != opaque:
        raise RuntimeError(f'{output}: unexpected opacity {is_opaque}')
    difference = float(
        magick(
            output,
            '-fx',
            'abs(r-g)+abs(g-b)',
            '-format',
            '%[fx:maxima]',
            'info:',
        )
    )
    if difference > 1 / 255:
        raise RuntimeError(f'{output}: unexpected colored pixels')


def write_svg(tree, output):
    tree.write(output, encoding='unicode', xml_declaration=True)
    output.write_text(
        '\n'.join(line.rstrip() for line in output.read_text().splitlines()) + '\n'
    )


def generate_task_count_svgs():
    base = ET.parse(TASK_COUNT_TEMPLATE)
    icon_layers(base, TASK_COUNT_TEMPLATE)

    for slug, count, scale, rows in STATES:
        tree = copy.deepcopy(base)
        root = tree.getroot()
        _, content = icon_layers(tree, TASK_COUNT_TEMPLATE)
        if count == 0:
            center_x, center_y = EMPTY_CHECK_CENTER
            points = [
                (
                    center_x + (x - center_x) * EMPTY_CHECK_PATH_SCALE,
                    center_y + (y - center_y) * EMPTY_CHECK_PATH_SCALE,
                )
                for x, y in EMPTY_CHECK_POINTS
            ]
            path = ''.join(
                f'{"M" if index == 0 else "L"}{x:g} {y:g}'
                for index, (x, y) in enumerate(points)
            )
            shadow = ET.SubElement(content, q('g'), {'filter': 'url(#metalShadow)'})
            for width, paint, offset in [
                (78, 'metalSide', 3),
                (76, 'ringBevel', 0),
                (66, 'silverFace', 0),
            ]:
                ET.SubElement(
                    shadow,
                    q('path'),
                    {
                        'd': path,
                        'fill': 'none',
                        'stroke': f'url(#{paint})',
                        'stroke-width': f'{width * EMPTY_CHECK_STROKE_SCALE:g}',
                        'stroke-linecap': 'round',
                        'stroke-linejoin': 'round',
                        'transform': f'translate(0 {offset})',
                    },
                )
            title = 'Zero: clear day checkmark'
            description = (
                'A continuous dark graphite-metal checkmark centered on a '
                'full-bleed white square.'
            )
        else:
            content.set(
                'transform',
                f'translate(512 500) scale({scale}) translate(-512 -500)',
            )
            for y in rows:
                ET.SubElement(
                    content,
                    q('use'),
                    {
                        f'{{{XLINK}}}href': '#taskRow',
                        'transform': f'translate(330 {y})',
                    },
                )
            amount = count if count < 4 else 'four or more'
            title = f'Zero: {amount} available tasks'
            description = (
                f'{count} centered open task rows in dark graphite metal on a '
                'full-bleed white square.'
            )
        root.find(q('title')).text = title
        root.find(q('desc')).text = description
        write_svg(tree, TASK_COUNT / f'{slug}.svg')


def artwork_tree(source, transform=None):
    tree = ET.parse(source)
    root = tree.getroot()
    background, artwork = icon_layers(tree, source)
    root.remove(background)

    if transform is not None:
        root.remove(artwork)
        wrapper = ET.SubElement(root, q('g'), {'transform': transform})
        wrapper.append(artwork)
    return tree


def web_favicon_tree(source):
    tree = artwork_tree(
        source,
        f'translate(512 500) scale({WEB_ARTWORK_SCALE}) translate(-512 -500)',
    )
    root = tree.getroot()
    root.find(q('title')).text = 'Zero: three bold graphite tasks'
    root.find(q('desc')).text = (
        'Three enlarged raised-metal task rings and bars on transparency.'
    )
    return tree


def monochrome_tree(tree):
    monochrome = copy.deepcopy(tree)
    for element in monochrome.getroot().iter():
        element.attrib.pop('filter', None)
        for attribute in ('fill', 'stroke'):
            if attribute in element.attrib and element.get(attribute) != 'none':
                element.set(attribute, '#000000')
    return monochrome


def foreground_trees(source):
    foreground = artwork_tree(
        source,
        'translate(512 512) scale(0.75) translate(-512 -500)',
    )
    return foreground, monochrome_tree(foreground)


def validate_safe_zone(path, mask):
    escaped = float(
        magick(
            path,
            '-alpha',
            'extract',
            mask,
            '-compose',
            'Multiply',
            '-composite',
            '-format',
            '%[fx:maxima]',
            'info:',
        )
    )
    if escaped > 1 / 255:
        raise RuntimeError(f'{path}: artwork escapes the adaptive safe zone')


def main():
    if shutil.which('magick') is None:
        raise SystemExit('ImageMagick 7 (magick) is required.')
    TASK_COUNT.mkdir(parents=True, exist_ok=True)
    TASK_COUNT_IMAGES.mkdir(parents=True, exist_ok=True)
    MOBILE.mkdir(parents=True, exist_ok=True)
    WEB.mkdir(parents=True, exist_ok=True)
    PROTOTYPE.mkdir(parents=True, exist_ok=True)

    icon_layers(ET.parse(STATIC_SOURCE), STATIC_SOURCE)
    generate_task_count_svgs()

    with tempfile.TemporaryDirectory(prefix='todo-icons-') as folder:
        temp = Path(folder)
        mask = temp / 'outside-safe.png'
        magick(
            '-size',
            '1024x1024',
            'xc:white',
            '-fill',
            'black',
            '-draw',
            'circle 512,512 824,512',
            mask,
        )

        previews = []
        for slug, *_ in STATES:
            source = TASK_COUNT / f'{slug}.svg'
            foreground, monochrome = foreground_trees(source)
            foreground_svg = temp / f'{slug}-foreground.svg'
            monochrome_svg = temp / f'{slug}-monochrome.svg'
            write_svg(foreground, foreground_svg)
            write_svg(monochrome, monochrome_svg)

            legacy = TASK_COUNT_IMAGES / f'{slug}.png'
            foreground_png = TASK_COUNT_IMAGES / f'{slug}-foreground.png'
            monochrome_png = TASK_COUNT_IMAGES / f'{slug}-monochrome.png'
            render(source, legacy, 1024, opaque=True)
            validate_corners(legacy, 'white')
            render(foreground_svg, foreground_png, 1024)
            validate_corners(foreground_png, 'transparent')
            if slug == '0-empty':
                validate_artwork_bounds(
                    foreground_png,
                    EMPTY_FOREGROUND_BOUNDS,
                    EMPTY_FOREGROUND_BOUNDS_TOLERANCE,
                )
            render(monochrome_svg, monochrome_png, 1024)
            validate_corners(monochrome_png, 'transparent')
            validate_safe_zone(foreground_png, mask)
            validate_safe_zone(monochrome_png, mask)

            preview = temp / f'{slug}.png'
            render(source, preview, 2048, opaque=True)
            validate_corners(preview, 'white')
            previews.append(preview)

        montage_args = []
        for preview, label in zip(previews, LABELS):
            montage_args += ['-label', label, preview]
        magick(
            'montage',
            '-font',
            'DejaVu-Sans',
            '-pointsize',
            '22',
            '-background',
            '#e5e5e5',
            '-fill',
            '#222222',
            *montage_args,
            '-thumbnail',
            '400x400',
            '-tile',
            '3x2',
            '-geometry',
            '+22+22',
            PROTOTYPE / 'comparison.png',
        )
        magick(PROTOTYPE / 'comparison.png', '-strip', PROTOTYPE / 'comparison.png')

        # The three-row source feeds native, splash, touch, and web adapters.
        icon = MOBILE / 'icon.png'
        render(STATIC_SOURCE, icon, 1024, opaque=True)
        validate_corners(icon, 'white')

        splash_tree = artwork_tree(STATIC_SOURCE)
        splash_svg = temp / 'splash.svg'
        write_svg(splash_tree, splash_svg)
        splash = MOBILE / 'splash-icon.png'
        render(splash_svg, splash, 512)
        validate_corners(splash, 'transparent')

        web_tree = web_favicon_tree(STATIC_SOURCE)
        write_svg(web_tree, WEB_SVG)
        web_preview = temp / 'favicon-mark.png'
        render(WEB_SVG, web_preview, 512)
        validate_corners(web_preview, 'transparent')
        validate_artwork_coverage(web_preview)

        favicon = MOBILE / 'favicon.png'
        render(WEB_SVG, favicon, 48)
        validate_corners(favicon, 'transparent')
        validate_artwork_coverage(favicon)
        shutil.copyfile(favicon, WEB_PNG)

        touch_icon = WEB / 'apple-touch-icon.png'
        render(STATIC_SOURCE, touch_icon, 180, opaque=True)
        validate_corners(touch_icon, 'white')
        for retired in RETIRED_WEB_ICONS:
            retired.unlink(missing_ok=True)

    # These static Android layers were superseded by the task-count primary icon.
    (MOBILE / 'android-icon-foreground.png').unlink(missing_ok=True)
    (MOBILE / 'android-icon-monochrome.png').unlink(missing_ok=True)

    print('Generated and validated static and task-count todo icons.')


if __name__ == '__main__':
    main()
