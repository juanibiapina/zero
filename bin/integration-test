#!/usr/bin/env bash

set -e

# Run the end-to-end Telegram round-trip test against production.
#
# Sends a real Telegram message as the test user, waits for the bot's
# reply, and asserts on it. Hits Anthropic and Telegram for real — run
# on demand, not on every commit.
#
# See docs/integration-tests.md for one-time setup.
#
# Loads test config from ZeroVault (zero-tests/development).
# Requires ZEROVAULT_API_KEY and ZEROVAULT_API_URL env vars.

ZV="pnpm dlx zerovault-cli@0.1.0"
eval "$($ZV secrets download -p zero-tests -e development --format shell)"

exec pnpm --filter @zero/integration-tests run test:integration
