#!/usr/bin/env bash

set -euo pipefail

# Fetch secrets from ZeroVault into local env files.
# Requires ZERO_API_KEY. ZERO_API_URL is optional.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ZERO=(pnpm dlx @zeroapps/cli@0.3.1)
TO_DOTENV=(node "$ROOT/bin/json-to-dotenv.mjs")

fetch_secrets() {
  local project="$1"
  local environment="$2"
  local target="$3"
  local temporary

  temporary="$(mktemp "${target}.XXXXXX")"
  if ! "${ZERO[@]}" vault secrets download -p "$project" -e "$environment" --format json | "${TO_DOTENV[@]}" > "$temporary"; then
    rm -f "$temporary"
    return 1
  fi
  mv "$temporary" "$target"
}

fetch_secrets zero-api development "$ROOT/apps/agent-api/.dev.vars"
fetch_secrets zero-web development "$ROOT/apps/agent-web/.env.local"
fetch_secrets zero-web production "$ROOT/apps/agent-web/.env.production"
fetch_secrets zerovault development "$ROOT/apps/vault-api/.dev.vars"
fetch_secrets zerovault-web development "$ROOT/apps/dashboard-web/.env"
fetch_secrets zerovault-web production "$ROOT/apps/dashboard-web/.env.production"
