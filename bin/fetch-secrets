#!/usr/bin/env bash

set -e

# Fetch secrets from Doppler (filtering out DOPPLER_* metadata)

doppler secrets download --config dev --project zero-api --no-file --format env | grep -v '^DOPPLER_' > apps/api/.dev.vars
doppler secrets download --config dev --project zero-web --no-file --format env | grep -v '^DOPPLER_' > apps/web/.env.local
doppler secrets download --config prd --project zero-web --no-file --format env | grep -v '^DOPPLER_' > apps/web/.env.production
