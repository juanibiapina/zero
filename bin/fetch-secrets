#!/usr/bin/env bash

set -e

# Fetch secrets from ZeroVault into local env files.
# Requires ZEROVAULT_API_KEY and ZEROVAULT_API_URL env vars.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ZV="pnpm dlx zerovault-cli@0.2.2"
TO_DOTENV="node $ROOT/bin/json-to-dotenv.mjs"

$ZV secrets download -p zero-api -e development --format json | $TO_DOTENV > "$ROOT/apps/agent-api/.dev.vars"
$ZV secrets download -p zero-web -e development --format json | $TO_DOTENV > "$ROOT/apps/agent-web/.env.local"
$ZV secrets download -p zero-web -e production --format json | $TO_DOTENV > "$ROOT/apps/agent-web/.env.production"

$ZV secrets download -p zerovault -e development --format json | $TO_DOTENV > "$ROOT/apps/vault-api/.dev.vars"
$ZV secrets download -p zerovault-web -e development --format json | $TO_DOTENV > "$ROOT/apps/dashboard-web/.env"
$ZV secrets download -p zerovault-web -e production --format json | $TO_DOTENV > "$ROOT/apps/dashboard-web/.env.production"
