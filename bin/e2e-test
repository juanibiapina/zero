#!/usr/bin/env bash
set -euo pipefail

# E2E test orchestrator: starts mock servers, wrangler dev, seeds KV, runs tests.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT_DIR"

PIDS=()
cleanup() {
  echo "Cleaning up..."
  for pid in "${PIDS[@]}"; do
    kill "$pid" 2>/dev/null || true
  done
  lsof -ti :3501 | xargs -r kill -9 2>/dev/null || true
  lsof -ti :3502 | xargs -r kill -9 2>/dev/null || true
  lsof -ti :8791 | xargs -r kill -9 2>/dev/null || true
  lsof -ti :9233 | xargs -r kill -9 2>/dev/null || true
}
trap cleanup EXIT

# Secrets come from ZeroVault and never touch the disk. Requires a credential
# (ZERO_API_KEY or `zero login`); ZERO_API_URL is optional.
ZERO="pnpm dlx @zeroapps/cli@0.7.0"

echo "=== Starting mock Telegram API on :3501 ==="
pnpm exec tsx packages/agent-e2e/src/mock-telegram.ts &
PIDS+=($!)

echo "=== Starting mock OpenAI API on :3502 ==="
pnpm exec tsx packages/agent-e2e/src/mock-openai.ts &
PIDS+=($!)

echo "=== Starting wrangler dev (test config) on :8791 ==="
# The mount path is relative to this script's working directory (the repo root),
# and must land next to the wrangler config, which is where wrangler looks for
# .dev.vars. The pipe disappears when the command exits.
$ZERO vault run -p zero-api -e development --mount apps/zero-api/.dev.vars -- \
  pnpm --dir apps/zero-api exec wrangler dev \
    --config wrangler.test.jsonc \
    --port 8791 \
    --inspector-port 9233 &
PIDS+=($!)

echo "=== Waiting for ports ==="
for port in 3501 3502 8791; do
  echo -n "  Waiting for :$port"
  timeout=60
  while ! nc -z localhost "$port" 2>/dev/null; do
    sleep 0.3
    timeout=$((timeout - 1))
    if [ "$timeout" -le 0 ]; then
      echo " TIMEOUT"
      echo "ERROR: Port $port did not become available"
      exit 1
    fi
    echo -n "."
  done
  echo " OK"
done

echo "=== Seeding KV (tg:12345 → user_test) ==="
pnpm --dir apps/zero-api exec wrangler kv key put \
  --binding KV --local --preview false --config wrangler.test.jsonc \
  "tg:12345" "user_test" || echo "WARN: KV seed may have failed"

echo "=== Running E2E tests ==="
$ZERO vault run -p zero-api -e development -- \
  pnpm --dir packages/agent-e2e exec vitest run

echo "=== E2E tests passed ==="
