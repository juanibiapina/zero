#!/usr/bin/env bash
set -euo pipefail

# E2E test orchestrator: starts mock servers, wrangler dev, seeds KV, runs tests.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT_DIR"

PIDS=()
cleanup() {
  echo "Cleaning up..."
  for pid in "${PIDS[@]}"; do
    kill "$pid" 2>/dev/null || true
  done
  lsof -ti :3501 | xargs -r kill -9 2>/dev/null || true
  lsof -ti :3502 | xargs -r kill -9 2>/dev/null || true
  lsof -ti :8791 | xargs -r kill -9 2>/dev/null || true
  lsof -ti :9233 | xargs -r kill -9 2>/dev/null || true
  # Restore original .dev.vars
  if [ -f apps/agent-api/.dev.vars.bak ]; then
    mv apps/agent-api/.dev.vars.bak apps/agent-api/.dev.vars
  fi
}
trap cleanup EXIT

echo "=== Preparing secrets ==="
# Regenerate .dev.vars from ZeroVault (json -> dotenv) and restore on exit.
# Requires ZERO_API_KEY. ZERO_API_URL is optional.
ZERO="pnpm dlx @zeroapps/cli@0.3.1"
cp apps/agent-api/.dev.vars apps/agent-api/.dev.vars.bak
$ZERO vault secrets download -p zero-api -e development --format json \
  | node bin/json-to-dotenv.mjs > apps/agent-api/.dev.vars
echo "=== Starting mock Telegram API on :3501 ==="
pnpm exec tsx packages/agent-e2e/src/mock-telegram.ts &
PIDS+=($!)

echo "=== Starting mock OpenAI API on :3502 ==="
pnpm exec tsx packages/agent-e2e/src/mock-openai.ts &
PIDS+=($!)

echo "=== Starting wrangler dev (test config) on :8791 ==="
pnpm --dir apps/agent-api exec wrangler dev \
  --config wrangler.test.jsonc \
  --port 8791 \
  --inspector-port 9233 &
PIDS+=($!)

echo "=== Waiting for ports ==="
for port in 3501 3502 8791; do
  echo -n "  Waiting for :$port"
  timeout=60
  while ! nc -z localhost "$port" 2>/dev/null; do
    sleep 0.3
    timeout=$((timeout - 1))
    if [ "$timeout" -le 0 ]; then
      echo " TIMEOUT"
      echo "ERROR: Port $port did not become available"
      exit 1
    fi
    echo -n "."
  done
  echo " OK"
done

echo "=== Seeding KV (tg:12345 → user_test) ==="
pnpm --dir apps/agent-api exec wrangler kv key put \
  --binding KV --local --preview false --config wrangler.test.jsonc \
  "tg:12345" "user_test" || echo "WARN: KV seed may have failed"

echo "=== Running E2E tests ==="
( eval "$($ZERO vault secrets download -p zero-api -e development --format shell)"
  pnpm --dir packages/agent-e2e exec vitest run )

echo "=== E2E tests passed ==="
