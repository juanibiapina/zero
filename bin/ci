#!/usr/bin/env bash

set -e

echo "=== Running Local CI Pipeline ==="

pnpm install
bin/fetch-secrets
pnpm --filter @zero/agent-api run cf-typegen
pnpm --filter @zero/dashboard-api run cf-typegen
# Order matches .github/workflows/ci.yml: lint first, then typecheck.
pnpm run lint -- --fix
pnpm run typecheck
pnpm run build
pnpm run test
pnpm run deploy -- --dry-run

echo "=== All CI checks passed ==="
