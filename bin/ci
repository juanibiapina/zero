#!/usr/bin/env bash

set -e

echo "=== Running Local CI Pipeline ==="

pnpm install
bin/fetch-secrets
pnpm --filter @zero/api run cf-typegen
pnpm --filter @zero/api run db:generate
pnpm run typecheck
pnpm run lint -- --fix
pnpm run build
pnpm run test
pnpm run deploy -- --dry-run

echo "=== All CI checks passed ==="
