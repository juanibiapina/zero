#!/usr/bin/env bash

set -e

# Sync production secrets from ZeroVault to Cloudflare Workers.
# Requires ZEROVAULT_API_KEY and ZEROVAULT_API_URL env vars.

ZV="pnpm dlx zerovault-cli@0.1.0"

echo "=== Syncing Zero API worker secrets ==="
$ZV secrets download -p zero-api -e production --format json | \
  pnpm --dir apps/agent-api exec wrangler secret bulk
