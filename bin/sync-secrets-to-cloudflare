#!/usr/bin/env bash

set -e

# Sync production secrets from ZeroVault to Cloudflare Workers.
# Requires ZERO_API_KEY. ZERO_API_URL is optional.
ZERO="pnpm dlx @zeroapps/cli@0.7.0"

echo "=== Syncing Zero API worker secrets ==="
$ZERO vault secrets download -p zero-api -e production --format json | \
  pnpm --dir apps/zero-api exec wrangler secret bulk

echo "=== Syncing Emoji worker secrets ==="
$ZERO vault secrets download -p zeroapps-emoji -e production --format json | \
  pnpm --dir apps/zeroapps-emoji exec wrangler secret bulk

echo "=== Syncing Dashboard worker secrets ==="
$ZERO vault secrets download -p zerovault -e production --format json | \
  pnpm --dir apps/zeroapps-api exec wrangler secret bulk
