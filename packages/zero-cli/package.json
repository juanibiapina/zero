{
  "name": "@zeroapps/cli",
  "version": "0.6.0",
  "description": "CLI for Zero: ZeroVault secrets and ZeroErrors issues",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanibiapina/zero.git",
    "directory": "packages/zero-cli"
  },
  "bin": {
    "zero": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@zero/eslint-config": "workspace:*",
    "@zero/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "eslint": "10.8.0",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
