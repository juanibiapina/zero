{
  "name": "@zero/agent-server",
  "version": "0.0.0",
  "description": "Standalone HTTP server for agentic sessions. Runtime-agnostic; deployed as a Cloudflare Container today but designed to run on any Node host.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@hono/node-server": "^2.0.2",
    "@hono/zod-openapi": "^1.2.2",
    "hono": "^4.12.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@zero/eslint-config": "workspace:*",
    "@zero/typescript-config": "workspace:*",
    "eslint": "9.39.3",
    "typescript": "5.9.3"
  }
}
