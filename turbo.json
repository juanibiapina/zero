{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "GITHUB_TOKEN",
    "CLOUDFLARE_API_TOKEN",
    "CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "VITE_CLERK_PUBLISHABLE_KEY",
    "VITE_TELEGRAM_BOT_USERNAME"
  ],
  // A `dev` task fetches its own secrets with `zero vault run`, so the CLI's
  // credential has to survive strict mode. These are passed through, not
  // hashed: they change nothing about a task's output.
  "globalPassThroughEnv": ["ZERO_API_KEY", "ZERO_API_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": { "outputs": [] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "dev": { "persistent": true, "cache": false },
    "test": { "outputs": [] },
    "deploy": { "dependsOn": ["build"], "cache": false },
    "@zero/agent-api#deploy": { "dependsOn": ["@zero/agent-web#build"], "cache": false },
    "@zero/dashboard-api#test": { "dependsOn": ["@zero/dashboard-web#build"], "outputs": [] },
    "@zero/dashboard-api#deploy": { "dependsOn": ["@zero/dashboard-web#build"], "cache": false }
  }
}
