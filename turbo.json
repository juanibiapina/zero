{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["GITHUB_TOKEN", "CLOUDFLARE_API_TOKEN", "CLERK_PUBLISHABLE_KEY", "CLERK_SECRET_KEY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.local",
        ".env.production",
        ".env.production.local",
        ".dev.vars"
      ]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test": {
      "outputs": []
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@zero/agent-api#deploy": {
      "dependsOn": ["@zero/agent-web#build"],
      "cache": false
    }
  }
}
