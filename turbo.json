{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "GITHUB_TOKEN",
    "CLOUDFLARE_API_TOKEN",
    "CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "VITE_CLERK_PUBLISHABLE_KEY",
    "VITE_TELEGRAM_BOT_USERNAME"
  ],
  // A `dev` task fetches its own secrets with `zero vault run`, so the CLI's
  // credential has to survive strict mode. These are passed through, not
  // hashed: they change nothing about a task's output.
  "globalPassThroughEnv": ["ZERO_API_KEY", "ZERO_API_URL"],
  "futureFlags": { "errorsOnlyShowHash": true },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "lint": { "outputs": [], "outputLogs": "errors-only" },
    "typecheck": { "dependsOn": ["^typecheck"], "outputLogs": "errors-only" },
    "dev": { "persistent": true, "cache": false },
    "test": { "outputs": [], "outputLogs": "errors-only" },
    "deploy": { "dependsOn": ["build"], "cache": false, "outputLogs": "errors-only" },
    "@zero/api#deploy": {
      "dependsOn": ["@zero/web#build"],
      "cache": false,
      "outputLogs": "errors-only"
    },
    "@zeroapps/api#test": {
      "dependsOn": ["@zeroapps/dashboard-web#build"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "@zeroapps/api#deploy": {
      "dependsOn": ["@zeroapps/dashboard-web#build"],
      "cache": false,
      "outputLogs": "errors-only"
    }
  }
}
